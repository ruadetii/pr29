<Page x:Class="Pr29_Radosteva.View.ParticipantsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:elements="clr-namespace:Pr29_Radosteva.View.Items"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ParticipantsPage">
    <Page.Resources>
        <Style TargetType="Button" x:Key="Update">
            <Setter Property="Background" Value="#FF2DD61B"/>
            <Setter Property="BorderBrush" Value="#FF2DD61B"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Label Content="{Binding SelectedEvent.Name}"
               ContentStringFormat="Участники события: {0}"
               FontSize="16"
               VerticalAlignment="Top"
               Margin="10,0,10,0"/>
        <ListView ItemsSource="{Binding Participants}" HorizontalContentAlignment="Stretch" Margin="0,30,0,45">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <elements:ParticipantItem DataContext="{Binding}"/>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Button Style="{StaticResource Update}"
                Command="{Binding OnBack}"
                Content="Назад"
                Height="25"
                Width="70"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Left"
                Margin="10,0,0,10">
            <Button.Effect>
                <DropShadowEffect Opacity="0.5" BlurRadius="3" ShadowDepth="3"></DropShadowEffect>
            </Button.Effect>
        </Button>
        <Button Style="{StaticResource Update}"
                Command="{Binding OnAddParticipant}"
                Content="Добавить"
                Height="25"
                Width="70"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Right"
                Margin="0,0,10,10">
            <Button.Effect>
                <DropShadowEffect Opacity="0.5" BlurRadius="3" ShadowDepth="3"></DropShadowEffect>
            </Button.Effect>
        </Button>
    </Grid>
</Page>
